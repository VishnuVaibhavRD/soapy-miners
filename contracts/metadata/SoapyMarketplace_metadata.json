mport \\\"@openzeppelin/contracts/utils/ReentrancyGuard.sol\\\";\\r\\n\\r\\n\\r\\ninterface ISoapyMinerGameMarketplace {\\r\\n    function marketplaceLockResource(\\r\\n        address seller,\\r\\n        uint256 sellerTokenId,\\r\\n        uint8 resourceType,\\r\\n        uint256 amount\\r\\n    )\\r\\n        external;\\r\\n\\r\\n    function marketplaceReturnResource(\\r\\n        address seller,\\r\\n        uint256 returnTokenId,\\r\\n        uint8 resourceType,\\r\\n        uint256 amount\\r\\n    )\\r\\n        external;\\r\\n\\r\\n    function marketplaceSettleTrade(\\r\\n        address buyer,\\r\\n        address seller,\\r\\n        uint256 buyerTokenId,\\r\\n        uint8 resourceType,\\r\\n        uint256 resourceAmount,\\r\\n        uint256 totalPrice,\\r\\n        uint256 marketplaceFee\\r\\n    )\\r\\n        external;\\r\\n}\\r\\n\\r\\n\\r\\ncontract SoapyMarketplace is\\r\\n    Ownable,\\r\\n    ReentrancyGuard\\r\\n{\\r\\n    /* =====================================================\\r\\n                        CUSTOM ERRORS\\r\\n    ===================================================== */\\r\\n\\r\\n    error InvalidGameContract();\\r\\n    error MarketplaceDisabled();\\r\\n    error InvalidAmount();\\r\\n    error InvalidPrice();\\r\\n    error InvalidListing();\\r\\n    error ListingInactive();\\r\\n    error NotListingSeller();\\r\\n    error CannotBuyOwnListing();\\r\\n    error InvalidFee();\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        CONSTANTS\\r\\n    ===================================================== */\\r\\n\\r\\n    uint256 public constant BASIS_POINTS =\\r\\n        10_000;\\r\\n\\r\\n    uint256 public constant MAX_FEE_BPS =\\r\\n        1_000;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        GAME CONTRACT\\r\\n    ===================================================== */\\r\\n\\r\\n    ISoapyMinerGameMarketplace\\r\\n        public immutable gameContract;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        MARKET CONFIG\\r\\n    ===================================================== */\\r\\n\\r\\n    uint16 public marketplaceFeeBps =\\r\\n        500;\\r\\n\\r\\n    bool public marketplaceActive =\\r\\n        true;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        LISTINGS\\r\\n    ===================================================== */\\r\\n\\r\\n    struct Listing {\\r\\n        address seller;\\r\\n\\r\\n        uint96 price;\\r\\n        uint64 amount;\\r\\n\\r\\n        uint8 resourceType;\\r\\n\\r\\n        bool active;\\r\\n    }\\r\\n\\r\\n\\r\\n    mapping(uint256 => Listing)\\r\\n        public listings;\\r\\n\\r\\n    uint256 public listingCount;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                            EVENTS\\r\\n    ===================================================== */\\r\\n\\r\\n    event ListingCreated(\\r\\n        uint256 indexed listingId,\\r\\n        address indexed seller,\\r\\n        uint256 indexed sellerTokenId,\\r\\n        uint8 resourceType,\\r\\n        uint256 amount,\\r\\n        uint256 price\\r\\n    );\\r\\n\\r\\n\\r\\n    event ListingCancelled(\\r\\n        uint256 indexed listingId,\\r\\n        address indexed seller,\\r\\n        uint256 indexed returnTokenId,\\r\\n        uint8 resourceType,\\r\\n        uint256 amount\\r\\n    );\\r\\n\\r\\n\\r\\n    event ListingSold(\\r\\n        uint256 indexed listingId,\\r\\n        address indexed seller,\\r\\n        address indexed buyer,\\r\\n        uint256 buyerTokenId,\\r\\n        uint8 resourceType,\\r\\n        uint256 amount,\\r\\n        uint256 price,\\r\\n        uint256 fee\\r\\n    );\\r\\n\\r\\n\\r\\n    event MarketplaceFeeUpdated(\\r\\n        uint256 previousFeeBps,\\r\\n        uint256 newFeeBps\\r\\n    );\\r\\n\\r\\n\\r\\n    event MarketplaceStatusUpdated(\\r\\n        bool active\\r\\n    );\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        CONSTRUCTOR\\r\\n    ===================================================== */\\r\\n\\r\\n    constructor(\\r\\n        address gameContractAddress\\r\\n    )\\r\\n        Ownable(msg.sender)\\r\\n    {\\r\\n        if (\\r\\n            gameContractAddress ==\\r\\n            address(0)\\r\\n        ) {\\r\\n            revert InvalidGameContract();\\r\\n        }\\r\\n\\r\\n\\r\\n        gameContract =\\r\\n            ISoapyMinerGameMarketplace(\\r\\n                gameContractAddress\\r\\n            );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        CREATE LISTING\\r\\n    ===================================================== */\\r\\n\\r\\n    function createListing(\\r\\n        uint256 sellerTokenId,\\r\\n        uint8 resourceType,\\r\\n        uint256 amount,\\r\\n        uint256 price\\r\\n    )\\r\\n        external\\r\\n        nonReentrant\\r\\n        returns (\\r\\n            uint256 listingId\\r\\n        )\\r\\n    {\\r\\n        if (!marketplaceActive) {\\r\\n            revert MarketplaceDisabled();\\r\\n        }\\r\\n\\r\\n        if (amount == 0) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            amount >\\r\\n            type(uint64).max\\r\\n        ) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        if (price == 0) {\\r\\n            revert InvalidPrice();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            price >\\r\\n            type(uint96).max\\r\\n        ) {\\r\\n            revert InvalidPrice();\\r\\n        }\\r\\n\\r\\n        if (resourceType > 2) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n\\r\\n        /*\\r\\n            Game contract verifies:\\r\\n            - seller ownership\\r\\n            - inventory amount\\r\\n            - resource type\\r\\n        */\\r\\n\\r\\n        gameContract\\r\\n            .marketplaceLockResource(\\r\\n                msg.sender,\\r\\n                sellerTokenId,\\r\\n                resourceType,\\r\\n                amount\\r\\n            );\\r\\n\\r\\n\\r\\n        unchecked {\\r\\n            listingCount++;\\r\\n        }\\r\\n\\r\\n        listingId =\\r\\n            listingCount;\\r\\n\\r\\n\\r\\n        listings[\\r\\n            listingId\\r\\n        ] =\\r\\n            Listing({\\r\\n                seller:\\r\\n                    msg.sender,\\r\\n\\r\\n                price:\\r\\n                    uint96(\\r\\n                        price\\r\\n                    ),\\r\\n\\r\\n                amount:\\r\\n                    uint64(\\r\\n                        amount\\r\\n                    ),\\r\\n\\r\\n                resourceType:\\r\\n                    resourceType,\\r\\n\\r\\n                active:\\r\\n                    true\\r\\n            });\\r\\n\\r\\n\\r\\n        emit ListingCreated(\\r\\n            listingId,\\r\\n            msg.sender,\\r\\n            sellerTokenId,\\r\\n            resourceType,\\r\\n            amount,\\r\\n            price\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        CANCEL LISTING\\r\\n    ===================================================== */\\r\\n\\r\\n    function cancelListing(\\r\\n        uint256 listingId,\\r\\n        uint256 returnTokenId\\r\\n    )\\r\\n        external\\r\\n        nonReentrant\\r\\n    {\\r\\n        Listing storage listing =\\r\\n            listings[\\r\\n                listingId\\r\\n            ];\\r\\n\\r\\n\\r\\n        if (\\r\\n            listing.seller ==\\r\\n            address(0)\\r\\n        ) {\\r\\n            revert InvalidListing();\\r\\n        }\\r\\n\\r\\n        if (!listing.active) {\\r\\n            revert ListingInactive();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            listing.seller !=\\r\\n            msg.sender\\r\\n        ) {\\r\\n            revert NotListingSeller();\\r\\n        }\\r\\n\\r\\n\\r\\n        /*\\r\\n            Effects first.\\r\\n        */\\r\\n\\r\\n        listing.active =\\r\\n            false;\\r\\n\\r\\n\\r\\n        /*\\r\\n            Game verifies seller currently\\r\\n            owns returnTokenId.\\r\\n        */\\r\\n\\r\\n        gameContract\\r\\n            .marketplaceReturnResource(\\r\\n                msg.sender,\\r\\n                returnTokenId,\\r\\n                listing.resourceType,\\r\\n                listing.amount\\r\\n            );\\r\\n\\r\\n\\r\\n        emit ListingCancelled(\\r\\n            listingId,\\r\\n            msg.sender,\\r\\n            returnTokenId,\\r\\n            listing.resourceType,\\r\\n            listing.amount\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        BUY LISTING\\r\\n    ===================================================== */\\r\\n\\r\\n    function buyListing(\\r\\n        uint256 listingId,\\r\\n        uint256 buyerTokenId\\r\\n    )\\r\\n        external\\r\\n        nonReentrant\\r\\n    {\\r\\n        if (!marketplaceActive) {\\r\\n            revert MarketplaceDisabled();\\r\\n        }\\r\\n\\r\\n\\r\\n        Listing storage listing =\\r\\n            listings[\\r\\n                listingId\\r\\n            ];\\r\\n\\r\\n\\r\\n        if (\\r\\n            listing.seller ==\\r\\n            address(0)\\r\\n        ) {\\r\\n            revert InvalidListing();\\r\\n        }\\r\\n\\r\\n        if (!listing.active) {\\r\\n            revert ListingInactive();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            listing.seller ==\\r\\n            msg.sender\\r\\n        ) {\\r\\n            revert CannotBuyOwnListing();\\r\\n        }\\r\\n\\r\\n\\r\\n        uint256 price =\\r\\n            uint256(\\r\\n                listing.price\\r\\n            );\\r\\n\\r\\n\\r\\n        uint256 fee =\\r\\n            (\\r\\n                price *\\r\\n                marketplaceFeeBps\\r\\n            )\\r\\n            /\\r\\n            BASIS_POINTS;\\r\\n\\r\\n\\r\\n        /*\\r\\n            Effects first.\\r\\n        */\\r\\n\\r\\n        listing.active =\\r\\n            false;\\r\\n\\r\\n\\r\\n        /*\\r\\n            Game performs:\\r\\n            - buyer ownership\\r\\n            - backpack capacity\\r\\n            - GD deduction\\r\\n            - seller GD credit\\r\\n            - resource credit\\r\\n        */\\r\\n\\r\\n        gameContract\\r\\n            .marketplaceSettleTrade(\\r\\n                msg.sender,\\r\\n                listing.seller,\\r\\n                buyerTokenId,\\r\\n                listing.resourceType,\\r\\n                listing.amount,\\r\\n                price,\\r\\n                fee\\r\\n            );\\r\\n\\r\\n\\r\\n        emit ListingSold(\\r\\n            listingId,\\r\\n            listing.seller,\\r\\n            msg.sender,\\r\\n            buyerTokenId,\\r\\n            listing.resourceType,\\r\\n            listing.amount,\\r\\n            price,\\r\\n            fee\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        VIEW LISTING\\r\\n    ===================================================== */\\r\\n\\r\\n    function getListing(\\r\\n        uint256 listingId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (\\r\\n            Listing memory\\r\\n        )\\r\\n    {\\r\\n        Listing memory listing =\\r\\n            listings[\\r\\n                listingId\\r\\n            ];\\r\\n\\r\\n\\r\\n        if (\\r\\n            listing.seller ==\\r\\n            address(0)\\r\\n        ) {\\r\\n            revert InvalidListing();\\r\\n        }\\r\\n\\r\\n\\r\\n        return listing;\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        CALCULATE FEE\\r\\n    ===================================================== */\\r\\n\\r\\n    function calculateMarketplaceFee(\\r\\n        uint256 price\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (\\r\\n            uint256\\r\\n        )\\r\\n    {\\r\\n        return\\r\\n            (\\r\\n                price *\\r\\n                marketplaceFeeBps\\r\\n            )\\r\\n            /\\r\\n            BASIS_POINTS;\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        ADMIN\\r\\n    ===================================================== */\\r\\n\\r\\n    function setMarketplaceFee(\\r\\n        uint256 newFeeBps\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        if (\\r\\n            newFeeBps >\\r\\n            MAX_FEE_BPS\\r\\n        ) {\\r\\n            revert InvalidFee();\\r\\n        }\\r\\n\\r\\n\\r\\n        uint256 previous =\\r\\n            marketplaceFeeBps;\\r\\n\\r\\n\\r\\n        marketplaceFeeBps =\\r\\n            uint16(\\r\\n                newFeeBps\\r\\n            );\\r\\n\\r\\n\\r\\n        emit MarketplaceFeeUpdated(\\r\\n            previous,\\r\\n            newFeeBps\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    function setMarketplaceActive(\\r\\n        bool active\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        marketplaceActive =\\r\\n            active;\\r\\n\\r\\n\\r\\n        emit MarketplaceStatusUpdated(\\r\\n            active\\r\\n        );\\r\\n    }\\r\\n}\\r\\n\",\"keccak256\":\"0x2d14993b9af94c10e0d8182d53fd3eb3e82e5ff6fd8de9ac3144268a25a9152a\",\"license\":\"MIT\"}},\"version\":1}"