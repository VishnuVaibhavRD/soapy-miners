 _nonReentrantBefore();\\n        _;\\n        _nonReentrantAfter();\\n    }\\n\\n    function _nonReentrantBefore() private {\\n        // On the first call to nonReentrant, _status will be NOT_ENTERED\\n        if (_status == ENTERED) {\\n            revert ReentrancyGuardReentrantCall();\\n        }\\n\\n        // Any calls to nonReentrant after this point will fail\\n        _status = ENTERED;\\n    }\\n\\n    function _nonReentrantAfter() private {\\n        // By storing the original value once again, a refund is triggered (see\\n        // https://eips.ethereum.org/EIPS/eip-2200)\\n        _status = NOT_ENTERED;\\n    }\\n\\n    /**\\n     * @dev Returns true if the reentrancy guard is currently set to \\\"entered\\\", which indicates there is a\\n     * `nonReentrant` function in the call stack.\\n     */\\n    function _reentrancyGuardEntered() internal view returns (bool) {\\n        return _status == ENTERED;\\n    }\\n}\\n\",\"keccak256\":\"0xf980daa263b661ab8ddee7d4fd833c7da7e7995e2c359ff1f17e67e4112f2236\",\"license\":\"MIT\"},\"contracts/SoapyMinerGame.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\r\\n\\r\\npragma solidity ^0.8.20;\\r\\n\\r\\nimport \\\"@openzeppelin/contracts/access/Ownable.sol\\\";\\r\\nimport \\\"@openzeppelin/contracts/utils/ReentrancyGuard.sol\\\";\\r\\n\\r\\ninterface ISoapyMiners {\\r\\n    function ownerOf(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (address);\\r\\n}\\r\\n\\r\\ncontract SoapyMinerGame is\\r\\n    Ownable,\\r\\n    ReentrancyGuard\\r\\n{\\r\\n    /* =====================================================\\r\\n                        CUSTOM ERRORS\\r\\n    ===================================================== */\\r\\n\\r\\n    error NotMinerOwner();\\r\\n    error MinerNotReady();\\r\\n    error InvalidMine();\\r\\n    error MineInactive();\\r\\n    error InsufficientGoldDust();\\r\\n    error InsufficientPower();\\r\\n    error ExpeditionAlreadyActive();\\r\\n    error NoActiveExpedition();\\r\\n    error ExpeditionNotFinished();\\r\\n    error BackpackFull();\\r\\n    error InvalidAmount();\\r\\n    error UnauthorizedMarketplace();\\r\\n    error UnauthorizedRewardMine();\\r\\n    error InsufficientOre();\\r\\n    error InsufficientCrystal();\\r\\n    error InsufficientCore();\\r\\n    error PickaxeMaxLevel();\\r\\n    error BackpackMaxLevel();\\r\\n    error NothingToWithdraw();\\r\\n    error InvalidNft();\\r\\n    error InvalidRate();\\r\\n    error UnsupportedMine();\\r\\n    error SendQuai();\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        NFT CONTRACT\\r\\n    ===================================================== */\\r\\n\\r\\n    ISoapyMiners public immutable soapyMiners;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        GOLD DUST\\r\\n    ===================================================== */\\r\\n\\r\\n    uint256 public goldDustPerQuai = 10;\\r\\n\\r\\n    mapping(address => uint256)\\r\\n        public goldDust;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        MINER STATE\\r\\n    ===================================================== */\\r\\n\\r\\n    struct MinerState {\\r\\n        uint64 xp;\\r\\n        uint64 restUntil;\\r\\n\\r\\n        uint8 pickaxeLevel;\\r\\n        uint8 backpackLevel;\\r\\n    }\\r\\n\\r\\n    mapping(uint256 => MinerState)\\r\\n        public miners;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        INVENTORY\\r\\n    ===================================================== */\\r\\n\\r\\n    struct Inventory {\\r\\n        uint64 ore;\\r\\n        uint64 crystal;\\r\\n        uint64 core;\\r\\n    }\\r\\n\\r\\n    mapping(uint256 => Inventory)\\r\\n        public inventories;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    RESOURCE TYPES\\r\\n    ===================================================== */\\r\\n\\r\\n    enum ResourceType {\\r\\n        ORE,\\r\\n        CRYSTAL,\\r\\n        CORE\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        MARKETPLACE\\r\\n    ===================================================== */\\r\\n\\r\\n    address public marketplace;\\r\\n\\r\\n    address public rewardMine;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        PICKAXE UPGRADES\\r\\n    ===================================================== */\\r\\n\\r\\n    struct PickaxeUpgradeCost {\\r\\n        uint256 goldDust;\\r\\n        uint256 ore;\\r\\n        uint256 crystal;\\r\\n        uint256 core;\\r\\n    }\\r\\n\\r\\n    mapping(uint256 => PickaxeUpgradeCost)\\r\\n        public pickaxeUpgradeCosts;\\r\\n\\r\\n    uint256 public constant MAX_PICKAXE_LEVEL = 5;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    BACKPACK UPGRADES\\r\\n    ===================================================== */\\r\\n\\r\\n    struct BackpackUpgradeCost {\\r\\n        uint256 goldDust;\\r\\n        uint256 ore;\\r\\n        uint256 crystal;\\r\\n        uint256 core;\\r\\n    }\\r\\n\\r\\n    mapping(uint256 => BackpackUpgradeCost)\\r\\n        public backpackUpgradeCosts;\\r\\n\\r\\n    uint256 public constant MAX_BACKPACK_LEVEL = 5;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                            MINES\\r\\n    ===================================================== */\\r\\n\\r\\n    struct Mine {\\r\\n        string name;\\r\\n\\r\\n        uint256 duration;\\r\\n\\r\\n        uint256 entryCost;\\r\\n\\r\\n        uint256 requiredPower;\\r\\n\\r\\n        uint256 xpReward;\\r\\n\\r\\n        bool active;\\r\\n    }\\r\\n\\r\\n    mapping(uint256 => Mine)\\r\\n        public mines;\\r\\n\\r\\n    uint256 public mineCount;\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        EXPEDITIONS\\r\\n    ===================================================== */\\r\\n\\r\\n    struct ActiveExpedition {\\r\\n        uint64 endsAt;\\r\\n        uint32 mineId;\\r\\n    }\\r\\n\\r\\n    mapping(uint256 => ActiveExpedition)\\r\\n        public activeExpeditions;\\r\\n\\r\\n\\r\\n    enum MinerStatus {\\r\\n        READY,\\r\\n        MINING,\\r\\n        CLAIMABLE,\\r\\n        RESTING\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                            EVENTS\\r\\n    ===================================================== */\\r\\n\\r\\n    event GoldDustPurchased(\\r\\n        address indexed player,\\r\\n        uint256 quaiPaid,\\r\\n        uint256 goldDustReceived\\r\\n    );\\r\\n\\r\\n    event MineUpdated(\\r\\n        uint256 indexed mineId,\\r\\n        string name,\\r\\n        uint256 duration,\\r\\n        uint256 entryCost,\\r\\n        uint256 requiredPower,\\r\\n        uint256 xpReward,\\r\\n        bool active\\r\\n    );\\r\\n\\r\\n    event ExpeditionStarted(\\r\\n        address indexed player,\\r\\n        uint256 indexed tokenId,\\r\\n        uint256 indexed mineId,\\r\\n        uint256 endsAt\\r\\n    );\\r\\n\\r\\n    event LootClaimed(\\r\\n        address indexed player,\\r\\n        uint256 indexed tokenId,\\r\\n        uint256 indexed mineId,\\r\\n        uint256 ore,\\r\\n        uint256 crystal,\\r\\n        uint256 core,\\r\\n        uint256 xp,\\r\\n        uint256 restUntil\\r\\n    );\\r\\n\\r\\n    event PickaxeUpgraded(\\r\\n        uint256 indexed tokenId,\\r\\n        address indexed player,\\r\\n        uint256 previousLevel,\\r\\n        uint256 newLevel,\\r\\n        uint256 newMiningPower,\\r\\n        uint256 goldDustSpent,\\r\\n        uint256 oreSpent,\\r\\n        uint256 crystalSpent,\\r\\n        uint256 coreSpent\\r\\n    );\\r\\n\\r\\n    event BackpackUpgraded(\\r\\n        uint256 indexed tokenId,\\r\\n        address indexed player,\\r\\n        uint256 previousLevel,\\r\\n        uint256 newLevel,\\r\\n        uint256 newCapacity,\\r\\n        uint256 goldDustSpent,\\r\\n        uint256 oreSpent,\\r\\n        uint256 crystalSpent,\\r\\n        uint256 coreSpent\\r\\n    );\\r\\n\\r\\n    event MarketplaceUpdated(\\r\\n        address indexed previousMarketplace,\\r\\n        address indexed newMarketplace\\r\\n    );\\r\\n\\r\\n    event RewardMineUpdated(\\r\\n        address indexed previousRewardMine,\\r\\n        address indexed newRewardMine\\r\\n    );\\r\\n\\r\\n    event MarketplaceResourceLocked(\\r\\n        address indexed seller,\\r\\n        uint256 indexed tokenId,\\r\\n        ResourceType resourceType,\\r\\n        uint256 amount\\r\\n    );\\r\\n\\r\\n    event MarketplaceResourceReturned(\\r\\n        uint256 indexed tokenId,\\r\\n        ResourceType resourceType,\\r\\n        uint256 amount\\r\\n    );\\r\\n\\r\\n    event MarketplaceTradeSettled(\\r\\n        address indexed buyer,\\r\\n        address indexed seller,\\r\\n        uint256 indexed buyerTokenId,\\r\\n        ResourceType resourceType,\\r\\n        uint256 resourceAmount,\\r\\n        uint256 price,\\r\\n        uint256 marketplaceFee\\r\\n    );\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        CONSTRUCTOR\\r\\n    ===================================================== */\\r\\n\\r\\n    constructor(\\r\\n        address nftContract\\r\\n    )\\r\\n        Ownable(msg.sender)\\r\\n    {\\r\\n        if (nftContract == address(0)) {\\r\\n            revert InvalidNft();\\r\\n        }\\r\\n\\r\\n        soapyMiners =\\r\\n            ISoapyMiners(\\r\\n                nftContract\\r\\n            );\\r\\n\\r\\n\\r\\n        /*\\r\\n            TEST CONFIGURATION\\r\\n\\r\\n            Basic:\\r\\n            2 minutes\\r\\n\\r\\n            Deep:\\r\\n            5 minutes\\r\\n\\r\\n            Ancient:\\r\\n            10 minutes\\r\\n        */\\r\\n\\r\\n        _createMine(\\r\\n            \\\"Basic Shaft\\\",\\r\\n            2 minutes,\\r\\n            50,\\r\\n            0,\\r\\n            100\\r\\n        );\\r\\n\\r\\n        _createMine(\\r\\n            \\\"Deep Mine\\\",\\r\\n            5 minutes,\\r\\n            70,\\r\\n            20,\\r\\n            250\\r\\n        );\\r\\n\\r\\n        _createMine(\\r\\n            \\\"Ancient Depths\\\",\\r\\n            10 minutes,\\r\\n            100,\\r\\n            50,\\r\\n            600\\r\\n        );\\r\\n\\r\\n\\r\\n        /*\\r\\n            PICKAXE UPGRADE COSTS\\r\\n\\r\\n            Key represents the destination level.\\r\\n        */\\r\\n\\r\\n        pickaxeUpgradeCosts[2] =\\r\\n            PickaxeUpgradeCost({\\r\\n                goldDust: 20,\\r\\n                ore: 50,\\r\\n                crystal: 5,\\r\\n                core: 0\\r\\n            });\\r\\n\\r\\n        pickaxeUpgradeCosts[3] =\\r\\n            PickaxeUpgradeCost({\\r\\n                goldDust: 40,\\r\\n                ore: 150,\\r\\n                crystal: 15,\\r\\n                core: 1\\r\\n            });\\r\\n\\r\\n        pickaxeUpgradeCosts[4] =\\r\\n            PickaxeUpgradeCost({\\r\\n                goldDust: 80,\\r\\n                ore: 300,\\r\\n                crystal: 35,\\r\\n                core: 3\\r\\n            });\\r\\n\\r\\n        pickaxeUpgradeCosts[5] =\\r\\n            PickaxeUpgradeCost({\\r\\n                goldDust: 150,\\r\\n                ore: 600,\\r\\n                crystal: 75,\\r\\n                core: 8\\r\\n            });\\r\\n\\r\\n\\r\\n        /*\\r\\n            BACKPACK UPGRADE COSTS\\r\\n\\r\\n            Key represents the destination level.\\r\\n        */\\r\\n\\r\\n        backpackUpgradeCosts[2] =\\r\\n            BackpackUpgradeCost({\\r\\n                goldDust: 20,\\r\\n                ore: 75,\\r\\n                crystal: 5,\\r\\n                core: 0\\r\\n            });\\r\\n\\r\\n        backpackUpgradeCosts[3] =\\r\\n            BackpackUpgradeCost({\\r\\n                goldDust: 45,\\r\\n                ore: 200,\\r\\n                crystal: 20,\\r\\n                core: 1\\r\\n            });\\r\\n\\r\\n        backpackUpgradeCosts[4] =\\r\\n            BackpackUpgradeCost({\\r\\n                goldDust: 90,\\r\\n                ore: 400,\\r\\n                crystal: 45,\\r\\n                core: 4\\r\\n            });\\r\\n\\r\\n        backpackUpgradeCosts[5] =\\r\\n            BackpackUpgradeCost({\\r\\n                goldDust: 175,\\r\\n                ore: 800,\\r\\n                crystal: 100,\\r\\n                core: 10\\r\\n            });\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        GOLD DUST\\r\\n    ===================================================== */\\r\\n\\r\\n    function buyGoldDust()\\r\\n        external\\r\\n        payable\\r\\n        nonReentrant\\r\\n    {\\r\\n        if (msg.value == 0) {\\r\\n            revert SendQuai();\\r\\n        }\\r\\n\\r\\n        /*\\r\\n            Native token uses 18 decimals.\\r\\n\\r\\n            Example:\\r\\n\\r\\n            1 QUAI\\r\\n            =\\r\\n            10 GD\\r\\n        */\\r\\n\\r\\n        uint256 amount =\\r\\n            (\\r\\n                msg.value *\\r\\n                goldDustPerQuai\\r\\n            )\\r\\n            /\\r\\n            1 ether;\\r\\n\\r\\n        require(\\r\\n            amount > 0,\\r\\n            \\\"Amount too small\\\"\\r\\n        );\\r\\n\\r\\n        goldDust[msg.sender]\\r\\n            += amount;\\r\\n\\r\\n        emit GoldDustPurchased(\\r\\n            msg.sender,\\r\\n            msg.value,\\r\\n            amount\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    MINER OWNERSHIP\\r\\n    ===================================================== */\\r\\n\\r\\n    modifier onlyMarketplace() {\\r\\n        if (msg.sender != marketplace) {\\r\\n            revert UnauthorizedMarketplace();\\r\\n        }\\r\\n\\r\\n        _;\\r\\n    }\\r\\n\\r\\n    modifier onlyRewardMine() {\\r\\n        if (msg.sender != rewardMine) {\\r\\n            revert UnauthorizedRewardMine();\\r\\n        }\\r\\n\\r\\n        _;\\r\\n    }\\r\\n\\r\\n    function ownsMiner(\\r\\n        address player,\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (bool)\\r\\n    {\\r\\n        try soapyMiners.ownerOf(\\r\\n            tokenId\\r\\n        )\\r\\n        returns (\\r\\n            address nftOwner\\r\\n        ) {\\r\\n            return\\r\\n                nftOwner ==\\r\\n                player;\\r\\n        }\\r\\n        catch {\\r\\n            return false;\\r\\n        }\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        MINER LEVEL\\r\\n    ===================================================== */\\r\\n\\r\\n    function getMinerLevel(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (uint256)\\r\\n    {\\r\\n        uint256 xp =\\r\\n            miners[tokenId].xp;\\r\\n\\r\\n        if (xp >= 1500) {\\r\\n            return 5;\\r\\n        }\\r\\n\\r\\n        if (xp >= 700) {\\r\\n            return 4;\\r\\n        }\\r\\n\\r\\n        if (xp >= 300) {\\r\\n            return 3;\\r\\n        }\\r\\n\\r\\n        if (xp >= 100) {\\r\\n            return 2;\\r\\n        }\\r\\n\\r\\n        return 1;\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    MINING POWER\\r\\n    ===================================================== */\\r\\n\\r\\n    function getPickaxeLevel(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (uint256)\\r\\n    {\\r\\n        uint256 level =\\r\\n            miners[tokenId]\\r\\n                .pickaxeLevel;\\r\\n\\r\\n        if (level == 0) {\\r\\n            return 1;\\r\\n        }\\r\\n\\r\\n        return level;\\r\\n    }\\r\\n\\r\\n    function getMiningPower(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (uint256)\\r\\n    {\\r\\n        return\\r\\n            getPickaxeLevel(tokenId)\\r\\n            * 10;\\r\\n    }\\r\\n\\r\\n    function getNextPickaxeUpgradeCost(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (\\r\\n            uint256 nextLevel,\\r\\n            uint256 goldDustCost,\\r\\n            uint256 oreCost,\\r\\n            uint256 crystalCost,\\r\\n            uint256 coreCost\\r\\n        )\\r\\n    {\\r\\n        uint256 currentLevel =\\r\\n            getPickaxeLevel(tokenId);\\r\\n\\r\\n        require(\\r\\n            currentLevel <\\r\\n                MAX_PICKAXE_LEVEL,\\r\\n            \\\"Pickaxe already max level\\\"\\r\\n        );\\r\\n\\r\\n        nextLevel =\\r\\n            currentLevel + 1;\\r\\n\\r\\n        PickaxeUpgradeCost storage cost =\\r\\n            pickaxeUpgradeCosts[\\r\\n                nextLevel\\r\\n            ];\\r\\n\\r\\n        return (\\r\\n            nextLevel,\\r\\n            cost.goldDust,\\r\\n            cost.ore,\\r\\n            cost.crystal,\\r\\n            cost.core\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function upgradePickaxe(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        nonReentrant\\r\\n    {\\r\\n        require(\\r\\n            ownsMiner(\\r\\n                msg.sender,\\r\\n                tokenId\\r\\n            ),\\r\\n            \\\"You do not own this miner\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            getMinerStatus(tokenId) ==\\r\\n                MinerStatus.READY,\\r\\n            \\\"Miner must be ready\\\"\\r\\n        );\\r\\n\\r\\n        uint256 currentLevel =\\r\\n            getPickaxeLevel(tokenId);\\r\\n\\r\\n        require(\\r\\n            currentLevel <\\r\\n                MAX_PICKAXE_LEVEL,\\r\\n            \\\"Pickaxe already max level\\\"\\r\\n        );\\r\\n\\r\\n        uint256 nextLevel =\\r\\n            currentLevel + 1;\\r\\n\\r\\n        PickaxeUpgradeCost storage cost =\\r\\n            pickaxeUpgradeCosts[\\r\\n                nextLevel\\r\\n            ];\\r\\n\\r\\n        Inventory storage inventory =\\r\\n            inventories[tokenId];\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                            BALANCE CHECKS\\r\\n        ===================================================== */\\r\\n\\r\\n        require(\\r\\n            goldDust[msg.sender] >=\\r\\n                cost.goldDust,\\r\\n            \\\"Not enough Gold Dust\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            inventory.ore >=\\r\\n                cost.ore,\\r\\n            \\\"Not enough Ore\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            inventory.crystal >=\\r\\n                cost.crystal,\\r\\n            \\\"Not enough Crystal\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            inventory.core >=\\r\\n                cost.core,\\r\\n            \\\"Not enough Core\\\"\\r\\n        );\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                            DEDUCT COSTS\\r\\n        ===================================================== */\\r\\n\\r\\n        goldDust[msg.sender] -=\\r\\n            cost.goldDust;\\r\\n\\r\\n        inventory.ore -=\\r\\n            uint64(cost.ore);\\r\\n\\r\\n        inventory.crystal -=\\r\\n            uint64(cost.crystal);\\r\\n\\r\\n        inventory.core -=\\r\\n            uint64(cost.core);\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                            APPLY UPGRADE\\r\\n        ===================================================== */\\r\\n\\r\\n        miners[tokenId]\\r\\n            .pickaxeLevel =\\r\\n                uint8(nextLevel);\\r\\n\\r\\n\\r\\n        emit PickaxeUpgraded(\\r\\n            tokenId,\\r\\n            msg.sender,\\r\\n            currentLevel,\\r\\n            nextLevel,\\r\\n            nextLevel * 10,\\r\\n            cost.goldDust,\\r\\n            cost.ore,\\r\\n            cost.crystal,\\r\\n            cost.core\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    BACKPACK UPGRADES\\r\\n    ===================================================== */\\r\\n\\r\\n    function getBackpackLevel(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (uint256)\\r\\n    {\\r\\n        uint256 level =\\r\\n            miners[tokenId]\\r\\n                .backpackLevel;\\r\\n\\r\\n        if (level == 0) {\\r\\n            return 1;\\r\\n        }\\r\\n\\r\\n        return level;\\r\\n    }\\r\\n\\r\\n    function getBackpackCapacity(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (uint256)\\r\\n    {\\r\\n        uint256 level =\\r\\n            getBackpackLevel(tokenId);\\r\\n\\r\\n        return\\r\\n            500 +\\r\\n            (level * 500);\\r\\n    }\\r\\n\\r\\n    function getInventoryTotal(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (uint256)\\r\\n    {\\r\\n        Inventory storage inventory =\\r\\n            inventories[tokenId];\\r\\n\\r\\n        return\\r\\n            inventory.ore +\\r\\n            inventory.crystal +\\r\\n            inventory.core;\\r\\n    }\\r\\n\\r\\n    function getNextBackpackUpgradeCost(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (\\r\\n            uint256 nextLevel,\\r\\n            uint256 goldDustCost,\\r\\n            uint256 oreCost,\\r\\n            uint256 crystalCost,\\r\\n            uint256 coreCost\\r\\n        )\\r\\n    {\\r\\n        uint256 currentLevel =\\r\\n            getBackpackLevel(tokenId);\\r\\n\\r\\n        require(\\r\\n            currentLevel <\\r\\n                MAX_BACKPACK_LEVEL,\\r\\n            \\\"Backpack already max level\\\"\\r\\n        );\\r\\n\\r\\n        nextLevel =\\r\\n            currentLevel + 1;\\r\\n\\r\\n        BackpackUpgradeCost storage cost =\\r\\n            backpackUpgradeCosts[\\r\\n                nextLevel\\r\\n            ];\\r\\n\\r\\n        return (\\r\\n            nextLevel,\\r\\n            cost.goldDust,\\r\\n            cost.ore,\\r\\n            cost.crystal,\\r\\n            cost.core\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function upgradeBackpack(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        nonReentrant\\r\\n    {\\r\\n        require(\\r\\n            ownsMiner(\\r\\n                msg.sender,\\r\\n                tokenId\\r\\n            ),\\r\\n            \\\"You do not own this miner\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            getMinerStatus(tokenId) ==\\r\\n                MinerStatus.READY,\\r\\n            \\\"Miner must be ready\\\"\\r\\n        );\\r\\n\\r\\n        uint256 currentLevel =\\r\\n            getBackpackLevel(tokenId);\\r\\n\\r\\n        require(\\r\\n            currentLevel <\\r\\n                MAX_BACKPACK_LEVEL,\\r\\n            \\\"Backpack already max level\\\"\\r\\n        );\\r\\n\\r\\n        uint256 nextLevel =\\r\\n            currentLevel + 1;\\r\\n\\r\\n        BackpackUpgradeCost storage cost =\\r\\n            backpackUpgradeCosts[\\r\\n                nextLevel\\r\\n            ];\\r\\n\\r\\n        Inventory storage inventory =\\r\\n            inventories[tokenId];\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                            BALANCE CHECKS\\r\\n        ===================================================== */\\r\\n\\r\\n        require(\\r\\n            goldDust[msg.sender] >=\\r\\n                cost.goldDust,\\r\\n            \\\"Not enough Gold Dust\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            inventory.ore >=\\r\\n                cost.ore,\\r\\n            \\\"Not enough Ore\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            inventory.crystal >=\\r\\n                cost.crystal,\\r\\n            \\\"Not enough Crystal\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            inventory.core >=\\r\\n                cost.core,\\r\\n            \\\"Not enough Core\\\"\\r\\n        );\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                            DEDUCT COSTS\\r\\n        ===================================================== */\\r\\n\\r\\n        goldDust[msg.sender] -=\\r\\n            cost.goldDust;\\r\\n\\r\\n        inventory.ore -=\\r\\n            uint64(cost.ore);\\r\\n\\r\\n        inventory.crystal -=\\r\\n            uint64(cost.crystal);\\r\\n\\r\\n        inventory.core -=\\r\\n            uint64(cost.core);\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                            APPLY UPGRADE\\r\\n        ===================================================== */\\r\\n\\r\\n        miners[tokenId]\\r\\n            .backpackLevel =\\r\\n                uint8(nextLevel);\\r\\n\\r\\n\\r\\n        emit BackpackUpgraded(\\r\\n            tokenId,\\r\\n            msg.sender,\\r\\n            currentLevel,\\r\\n            nextLevel,\\r\\n            getBackpackCapacity(tokenId),\\r\\n            cost.goldDust,\\r\\n            cost.ore,\\r\\n            cost.crystal,\\r\\n            cost.core\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    MARKETPLACE BRIDGE\\r\\n    ===================================================== */\\r\\n\\r\\n    function marketplaceLockResource(\\r\\n        address seller,\\r\\n        uint256 sellerTokenId,\\r\\n        ResourceType resourceType,\\r\\n        uint256 amount\\r\\n    )\\r\\n        external\\r\\n        onlyMarketplace\\r\\n    {\\r\\n        if (seller == address(0)) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            amount == 0 ||\\r\\n            amount > type(uint64).max\\r\\n        ) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            !ownsMiner(\\r\\n                seller,\\r\\n                sellerTokenId\\r\\n            )\\r\\n        ) {\\r\\n            revert NotMinerOwner();\\r\\n        }\\r\\n\\r\\n        Inventory storage inventory =\\r\\n            inventories[sellerTokenId];\\r\\n\\r\\n        uint64 locked =\\r\\n            uint64(amount);\\r\\n\\r\\n        if (\\r\\n            resourceType ==\\r\\n            ResourceType.ORE\\r\\n        ) {\\r\\n            if (inventory.ore < locked) {\\r\\n                revert InsufficientOre();\\r\\n            }\\r\\n\\r\\n            inventory.ore -= locked;\\r\\n        }\\r\\n        else if (\\r\\n            resourceType ==\\r\\n            ResourceType.CRYSTAL\\r\\n        ) {\\r\\n            if (\\r\\n                inventory.crystal < locked\\r\\n            ) {\\r\\n                revert InsufficientCrystal();\\r\\n            }\\r\\n\\r\\n            inventory.crystal -= locked;\\r\\n        }\\r\\n        else if (\\r\\n            resourceType ==\\r\\n            ResourceType.CORE\\r\\n        ) {\\r\\n            if (inventory.core < locked) {\\r\\n                revert InsufficientCore();\\r\\n            }\\r\\n\\r\\n            inventory.core -= locked;\\r\\n        }\\r\\n        else {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        emit MarketplaceResourceLocked(\\r\\n            seller,\\r\\n            sellerTokenId,\\r\\n            resourceType,\\r\\n            amount\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function marketplaceReturnResource(\\r\\n        address seller,\\r\\n        uint256 returnTokenId,\\r\\n        ResourceType resourceType,\\r\\n        uint256 amount\\r\\n    )\\r\\n        external\\r\\n        onlyMarketplace\\r\\n    {\\r\\n        require(\\r\\n            seller != address(0),\\r\\n            \\\"Invalid seller\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            amount > 0,\\r\\n            \\\"Invalid amount\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            ownsMiner(\\r\\n                seller,\\r\\n                returnTokenId\\r\\n            ),\\r\\n            \\\"Seller does not own return miner\\\"\\r\\n        );\\r\\n\\r\\n        if (\\r\\n            amount == 0 ||\\r\\n            amount > type(uint64).max\\r\\n        ) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        Inventory storage inventory =\\r\\n            inventories[returnTokenId];\\r\\n\\r\\n        uint64 returned =\\r\\n            uint64(amount);\\r\\n\\r\\n        if (\\r\\n            resourceType ==\\r\\n            ResourceType.ORE\\r\\n        ) {\\r\\n            inventory.ore += returned;\\r\\n        }\\r\\n        else if (\\r\\n            resourceType ==\\r\\n            ResourceType.CRYSTAL\\r\\n        ) {\\r\\n            inventory.crystal += returned;\\r\\n        }\\r\\n        else if (\\r\\n            resourceType ==\\r\\n            ResourceType.CORE\\r\\n        ) {\\r\\n            inventory.core += returned;\\r\\n        }\\r\\n        else {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        emit MarketplaceResourceReturned(\\r\\n            returnTokenId,\\r\\n            resourceType,\\r\\n            amount\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function marketplaceSettleTrade(\\r\\n        address buyer,\\r\\n        address seller,\\r\\n        uint256 buyerTokenId,\\r\\n        ResourceType resourceType,\\r\\n        uint256 resourceAmount,\\r\\n        uint256 totalPrice,\\r\\n        uint256 marketplaceFee\\r\\n    )\\r\\n        external\\r\\n        onlyMarketplace\\r\\n    {\\r\\n        require(\\r\\n            buyer != address(0),\\r\\n            \\\"Invalid buyer\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            seller != address(0),\\r\\n            \\\"Invalid seller\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            buyer != seller,\\r\\n            \\\"Cannot buy own listing\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            resourceAmount > 0,\\r\\n            \\\"Invalid resource amount\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            totalPrice > 0,\\r\\n            \\\"Invalid price\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            marketplaceFee <= totalPrice,\\r\\n            \\\"Invalid marketplace fee\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            ownsMiner(\\r\\n                buyer,\\r\\n                buyerTokenId\\r\\n            ),\\r\\n            \\\"Buyer does not own miner\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            goldDust[buyer] >= totalPrice,\\r\\n            \\\"Not enough Gold Dust\\\"\\r\\n        );\\r\\n\\r\\n        uint256 currentInventory =\\r\\n            getInventoryTotal(\\r\\n                buyerTokenId\\r\\n            );\\r\\n\\r\\n        uint256 capacity =\\r\\n            getBackpackCapacity(\\r\\n                buyerTokenId\\r\\n            );\\r\\n\\r\\n        require(\\r\\n            currentInventory +\\r\\n                resourceAmount <=\\r\\n                capacity,\\r\\n            \\\"Buyer backpack full\\\"\\r\\n        );\\r\\n\\r\\n        /*\\r\\n            Deduct the full purchase price.\\r\\n        */\\r\\n\\r\\n        goldDust[buyer] -=\\r\\n            totalPrice;\\r\\n\\r\\n        /*\\r\\n            Marketplace fee is burned by\\r\\n            not crediting it to any wallet.\\r\\n        */\\r\\n\\r\\n        uint256 sellerAmount =\\r\\n            totalPrice -\\r\\n            marketplaceFee;\\r\\n\\r\\n        goldDust[seller] +=\\r\\n            sellerAmount;\\r\\n\\r\\n        /*\\r\\n            Credit purchased resources to\\r\\n            the buyer's selected Soapy.\\r\\n        */\\r\\n\\r\\n        if (resourceAmount > type(uint64).max) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        Inventory storage buyerInventory =\\r\\n            inventories[buyerTokenId];\\r\\n\\r\\n        uint64 credited =\\r\\n            uint64(resourceAmount);\\r\\n\\r\\n        if (\\r\\n            resourceType ==\\r\\n            ResourceType.ORE\\r\\n        ) {\\r\\n            buyerInventory.ore +=\\r\\n                credited;\\r\\n        }\\r\\n        else if (\\r\\n            resourceType ==\\r\\n            ResourceType.CRYSTAL\\r\\n        ) {\\r\\n            buyerInventory.crystal +=\\r\\n                credited;\\r\\n        }\\r\\n        else if (\\r\\n            resourceType ==\\r\\n            ResourceType.CORE\\r\\n        ) {\\r\\n            buyerInventory.core +=\\r\\n                credited;\\r\\n        }\\r\\n        else {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        emit MarketplaceTradeSettled(\\r\\n            buyer,\\r\\n            seller,\\r\\n            buyerTokenId,\\r\\n            resourceType,\\r\\n            resourceAmount,\\r\\n            totalPrice,\\r\\n            marketplaceFee\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    REWARD MINE BRIDGE\\r\\n    ===================================================== */\\r\\n\\r\\n    function canEnterRewardMine(\\r\\n        address player,\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (bool)\\r\\n    {\\r\\n        if (\\r\\n            !ownsMiner(\\r\\n                player,\\r\\n                tokenId\\r\\n            )\\r\\n        ) {\\r\\n            return false;\\r\\n        }\\r\\n\\r\\n        return\\r\\n            getMinerStatus(tokenId) ==\\r\\n            MinerStatus.READY;\\r\\n    }\\r\\n\\r\\n    function getRewardAttackState(\\r\\n        address player,\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (\\r\\n            bool owns,\\r\\n            uint8 status,\\r\\n            uint8 level,\\r\\n            uint8 pickaxeLevel,\\r\\n            uint256 gdBalance\\r\\n        )\\r\\n    {\\r\\n        owns =\\r\\n            ownsMiner(\\r\\n                player,\\r\\n                tokenId\\r\\n            );\\r\\n\\r\\n        status =\\r\\n            uint8(\\r\\n                getMinerStatus(tokenId)\\r\\n            );\\r\\n\\r\\n        level =\\r\\n            uint8(\\r\\n                getMinerLevel(tokenId)\\r\\n            );\\r\\n\\r\\n        pickaxeLevel =\\r\\n            uint8(\\r\\n                getPickaxeLevel(tokenId)\\r\\n            );\\r\\n\\r\\n        gdBalance =\\r\\n            goldDust[player];\\r\\n    }\\r\\n\\r\\n    function processRewardMineAttack(\\r\\n        address player,\\r\\n        uint256 tokenId,\\r\\n        uint256 gdFee,\\r\\n        uint256 restDuration\\r\\n    )\\r\\n        external\\r\\n        onlyRewardMine\\r\\n    {\\r\\n        if (\\r\\n            soapyMiners.ownerOf(tokenId) !=\\r\\n            player\\r\\n        ) {\\r\\n            revert NotMinerOwner();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            getMinerStatus(tokenId) !=\\r\\n            MinerStatus.READY\\r\\n        ) {\\r\\n            revert MinerNotReady();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            goldDust[player] <\\r\\n            gdFee\\r\\n        ) {\\r\\n            revert InsufficientGoldDust();\\r\\n        }\\r\\n\\r\\n        if (restDuration == 0) {\\r\\n            revert InvalidAmount();\\r\\n        }\\r\\n\\r\\n        goldDust[player] -=\\r\\n            gdFee;\\r\\n\\r\\n        miners[tokenId]\\r\\n            .restUntil =\\r\\n                uint64(\\r\\n                    block.timestamp +\\r\\n                    restDuration\\r\\n                );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    MINER STATUS\\r\\n    ===================================================== */\\r\\n\\r\\n    function getMinerStatus(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        public\\r\\n        view\\r\\n        returns (MinerStatus)\\r\\n    {\\r\\n        ActiveExpedition storage expedition =\\r\\n            activeExpeditions[tokenId];\\r\\n\\r\\n        if (expedition.mineId != 0) {\\r\\n            if (\\r\\n                block.timestamp <\\r\\n                expedition.endsAt\\r\\n            ) {\\r\\n                return MinerStatus.MINING;\\r\\n            }\\r\\n\\r\\n            return MinerStatus.CLAIMABLE;\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            block.timestamp <\\r\\n            miners[tokenId].restUntil\\r\\n        ) {\\r\\n            return MinerStatus.RESTING;\\r\\n        }\\r\\n\\r\\n        return MinerStatus.READY;\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        EXPEDITIONS\\r\\n    ===================================================== */\\r\\n\\r\\n    function startExpedition(\\r\\n        uint256 tokenId,\\r\\n        uint256 mineId\\r\\n    )\\r\\n        external\\r\\n        nonReentrant\\r\\n    {\\r\\n        if (\\r\\n            mineId == 0 ||\\r\\n            mineId > mineCount\\r\\n        ) {\\r\\n            revert InvalidMine();\\r\\n        }\\r\\n\\r\\n        Mine storage mine =\\r\\n            mines[mineId];\\r\\n\\r\\n        if (!mine.active) {\\r\\n            revert MineInactive();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            !ownsMiner(\\r\\n                msg.sender,\\r\\n                tokenId\\r\\n            )\\r\\n        ) {\\r\\n            revert NotMinerOwner();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            getMinerStatus(tokenId) !=\\r\\n            MinerStatus.READY\\r\\n        ) {\\r\\n            revert MinerNotReady();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            activeExpeditions[tokenId]\\r\\n                .mineId != 0\\r\\n        ) {\\r\\n            revert ExpeditionAlreadyActive();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            getMiningPower(tokenId) <\\r\\n            mine.requiredPower\\r\\n        ) {\\r\\n            revert InsufficientPower();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            goldDust[msg.sender] <\\r\\n            mine.entryCost\\r\\n        ) {\\r\\n            revert InsufficientGoldDust();\\r\\n        }\\r\\n\\r\\n        goldDust[msg.sender] -=\\r\\n            mine.entryCost;\\r\\n\\r\\n        uint64 endsAt =\\r\\n            uint64(\\r\\n                block.timestamp +\\r\\n                mine.duration\\r\\n            );\\r\\n\\r\\n        activeExpeditions[tokenId] =\\r\\n            ActiveExpedition({\\r\\n                endsAt:\\r\\n                    endsAt,\\r\\n\\r\\n                mineId:\\r\\n                    uint32(mineId)\\r\\n            });\\r\\n\\r\\n        emit ExpeditionStarted(\\r\\n            msg.sender,\\r\\n            tokenId,\\r\\n            mineId,\\r\\n            endsAt\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    function getExpeditionTimeRemaining(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (uint256)\\r\\n    {\\r\\n        ActiveExpedition storage expedition =\\r\\n            activeExpeditions[tokenId];\\r\\n\\r\\n        if (expedition.mineId == 0) {\\r\\n            revert NoActiveExpedition();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            block.timestamp >=\\r\\n            expedition.endsAt\\r\\n        ) {\\r\\n            return 0;\\r\\n        }\\r\\n\\r\\n        return\\r\\n            uint256(expedition.endsAt) -\\r\\n            block.timestamp;\\r\\n    }\\r\\n\\r\\n\\r\\n    function getActiveExpedition(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        view\\r\\n        returns (\\r\\n            ActiveExpedition memory\\r\\n        )\\r\\n    {\\r\\n        ActiveExpedition memory expedition =\\r\\n            activeExpeditions[tokenId];\\r\\n\\r\\n        if (expedition.mineId == 0) {\\r\\n            revert NoActiveExpedition();\\r\\n        }\\r\\n\\r\\n        return expedition;\\r\\n    }\\r\\n\\r\\n\\r\\n    function claimLoot(\\r\\n        uint256 tokenId\\r\\n    )\\r\\n        external\\r\\n        nonReentrant\\r\\n    {\\r\\n        ActiveExpedition memory expedition =\\r\\n            activeExpeditions[tokenId];\\r\\n\\r\\n        if (expedition.mineId == 0) {\\r\\n            revert NoActiveExpedition();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            !ownsMiner(\\r\\n                msg.sender,\\r\\n                tokenId\\r\\n            )\\r\\n        ) {\\r\\n            revert NotMinerOwner();\\r\\n        }\\r\\n\\r\\n        if (\\r\\n            block.timestamp <\\r\\n            expedition.endsAt\\r\\n        ) {\\r\\n            revert ExpeditionNotFinished();\\r\\n        }\\r\\n\\r\\n        Mine storage mine =\\r\\n            mines[expedition.mineId];\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                        TEMPORARY TEST LOOT\\r\\n        ===================================================== */\\r\\n\\r\\n        uint256 oreReward;\\r\\n        uint256 crystalReward;\\r\\n        uint256 coreReward;\\r\\n\\r\\n\\r\\n        if (expedition.mineId == 1) {\\r\\n            oreReward = 100;\\r\\n            crystalReward = 5;\\r\\n            coreReward = 0;\\r\\n        }\\r\\n        else if (expedition.mineId == 2) {\\r\\n            oreReward = 200;\\r\\n            crystalReward = 15;\\r\\n            coreReward = 1;\\r\\n        }\\r\\n        else if (expedition.mineId == 3) {\\r\\n            oreReward = 350;\\r\\n            crystalReward = 30;\\r\\n            coreReward = 3;\\r\\n        }\\r\\n        else {\\r\\n            revert UnsupportedMine();\\r\\n        }\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                        BACKPACK CHECK\\r\\n        ===================================================== */\\r\\n\\r\\n        Inventory storage inventory =\\r\\n            inventories[tokenId];\\r\\n\\r\\n        uint256 capacity =\\r\\n            getBackpackCapacity(\\r\\n                tokenId\\r\\n            );\\r\\n\\r\\n        uint256 currentInventory =\\r\\n            uint256(inventory.ore) +\\r\\n            uint256(inventory.crystal) +\\r\\n            uint256(inventory.core);\\r\\n\\r\\n        uint256 incomingLoot =\\r\\n            oreReward +\\r\\n            crystalReward +\\r\\n            coreReward;\\r\\n\\r\\n        if (\\r\\n            currentInventory +\\r\\n            incomingLoot >\\r\\n            capacity\\r\\n        ) {\\r\\n            revert BackpackFull();\\r\\n        }\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                        CREDIT LOOT + XP\\r\\n        ===================================================== */\\r\\n\\r\\n        inventory.ore +=\\r\\n            uint64(oreReward);\\r\\n\\r\\n        inventory.crystal +=\\r\\n            uint64(crystalReward);\\r\\n\\r\\n        inventory.core +=\\r\\n            uint64(coreReward);\\r\\n\\r\\n        miners[tokenId].xp +=\\r\\n            uint64(mine.xpReward);\\r\\n\\r\\n\\r\\n        /* =====================================================\\r\\n                    CLEAR EXPEDITION + REST\\r\\n        ===================================================== */\\r\\n\\r\\n        delete activeExpeditions[\\r\\n            tokenId\\r\\n        ];\\r\\n\\r\\n        uint64 restUntil =\\r\\n            uint64(\\r\\n                block.timestamp +\\r\\n                mine.duration\\r\\n            );\\r\\n\\r\\n        miners[tokenId]\\r\\n            .restUntil =\\r\\n                restUntil;\\r\\n\\r\\n\\r\\n        emit LootClaimed(\\r\\n            msg.sender,\\r\\n            tokenId,\\r\\n            expedition.mineId,\\r\\n            oreReward,\\r\\n            crystalReward,\\r\\n            coreReward,\\r\\n            mine.xpReward,\\r\\n            restUntil\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        ADMIN - MINES\\r\\n    ===================================================== */\\r\\n\\r\\n    function _createMine(\\r\\n        string memory name,\\r\\n        uint256 duration,\\r\\n        uint256 entryCost,\\r\\n        uint256 requiredPower,\\r\\n        uint256 xpReward\\r\\n    )\\r\\n        internal\\r\\n    {\\r\\n        mineCount++;\\r\\n\\r\\n        mines[mineCount] =\\r\\n            Mine({\\r\\n                name: name,\\r\\n\\r\\n                duration:\\r\\n                    duration,\\r\\n\\r\\n                entryCost:\\r\\n                    entryCost,\\r\\n\\r\\n                requiredPower:\\r\\n                    requiredPower,\\r\\n\\r\\n                xpReward:\\r\\n                    xpReward,\\r\\n\\r\\n                active:\\r\\n                    true\\r\\n            });\\r\\n\\r\\n        emit MineUpdated(\\r\\n            mineCount,\\r\\n            name,\\r\\n            duration,\\r\\n            entryCost,\\r\\n            requiredPower,\\r\\n            xpReward,\\r\\n            true\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    function updateMine(\\r\\n        uint256 mineId,\\r\\n        string calldata name,\\r\\n        uint256 duration,\\r\\n        uint256 entryCost,\\r\\n        uint256 requiredPower,\\r\\n        uint256 xpReward,\\r\\n        bool active\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        require(\\r\\n            mineId > 0 &&\\r\\n            mineId <= mineCount,\\r\\n            \\\"Invalid mine\\\"\\r\\n        );\\r\\n\\r\\n        require(\\r\\n            duration > 0,\\r\\n            \\\"Invalid duration\\\"\\r\\n        );\\r\\n\\r\\n        mines[mineId] =\\r\\n            Mine({\\r\\n                name: name,\\r\\n\\r\\n                duration:\\r\\n                    duration,\\r\\n\\r\\n                entryCost:\\r\\n                    entryCost,\\r\\n\\r\\n                requiredPower:\\r\\n                    requiredPower,\\r\\n\\r\\n                xpReward:\\r\\n                    xpReward,\\r\\n\\r\\n                active:\\r\\n                    active\\r\\n            });\\r\\n\\r\\n        emit MineUpdated(\\r\\n            mineId,\\r\\n            name,\\r\\n            duration,\\r\\n            entryCost,\\r\\n            requiredPower,\\r\\n            xpReward,\\r\\n            active\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    MARKETPLACE CONFIG\\r\\n    ===================================================== */\\r\\n\\r\\n    function setMarketplace(\\r\\n        address newMarketplace\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        address previousMarketplace =\\r\\n            marketplace;\\r\\n\\r\\n        marketplace =\\r\\n            newMarketplace;\\r\\n\\r\\n        emit MarketplaceUpdated(\\r\\n            previousMarketplace,\\r\\n            newMarketplace\\r\\n        );\\r\\n    }\\r\\n\\r\\n    function setRewardMine(\\r\\n        address newRewardMine\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        address previous =\\r\\n            rewardMine;\\r\\n\\r\\n        rewardMine =\\r\\n            newRewardMine;\\r\\n\\r\\n        emit RewardMineUpdated(\\r\\n            previous,\\r\\n            newRewardMine\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    PICKAXE UPGRADE CONFIG\\r\\n    ===================================================== */\\r\\n\\r\\n    function setPickaxeUpgradeCost(\\r\\n        uint256 destinationLevel,\\r\\n        uint256 goldDustCost,\\r\\n        uint256 oreCost,\\r\\n        uint256 crystalCost,\\r\\n        uint256 coreCost\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        require(\\r\\n            destinationLevel >= 2 &&\\r\\n            destinationLevel <=\\r\\n                MAX_PICKAXE_LEVEL,\\r\\n            \\\"Invalid pickaxe level\\\"\\r\\n        );\\r\\n\\r\\n        pickaxeUpgradeCosts[\\r\\n            destinationLevel\\r\\n        ] = PickaxeUpgradeCost({\\r\\n            goldDust:\\r\\n                goldDustCost,\\r\\n\\r\\n            ore:\\r\\n                oreCost,\\r\\n\\r\\n            crystal:\\r\\n                crystalCost,\\r\\n\\r\\n            core:\\r\\n                coreCost\\r\\n        });\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    BACKPACK UPGRADE CONFIG\\r\\n    ===================================================== */\\r\\n\\r\\n    function setBackpackUpgradeCost(\\r\\n        uint256 destinationLevel,\\r\\n        uint256 goldDustCost,\\r\\n        uint256 oreCost,\\r\\n        uint256 crystalCost,\\r\\n        uint256 coreCost\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        require(\\r\\n            destinationLevel >= 2 &&\\r\\n            destinationLevel <=\\r\\n                MAX_BACKPACK_LEVEL,\\r\\n            \\\"Invalid backpack level\\\"\\r\\n        );\\r\\n\\r\\n        backpackUpgradeCosts[\\r\\n            destinationLevel\\r\\n        ] = BackpackUpgradeCost({\\r\\n            goldDust:\\r\\n                goldDustCost,\\r\\n\\r\\n            ore:\\r\\n                oreCost,\\r\\n\\r\\n            crystal:\\r\\n                crystalCost,\\r\\n\\r\\n            core:\\r\\n                coreCost\\r\\n        });\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                    GOLD DUST CONFIG\\r\\n    ===================================================== */\\r\\n\\r\\n    function setGoldDustRate(\\r\\n        uint256 newRate\\r\\n    )\\r\\n        external\\r\\n        onlyOwner\\r\\n    {\\r\\n        require(\\r\\n            newRate > 0,\\r\\n            \\\"Invalid rate\\\"\\r\\n        );\\r\\n\\r\\n        goldDustPerQuai =\\r\\n            newRate;\\r\\n    }\\r\\n\\r\\n\\r\\n    /* =====================================================\\r\\n                        TREASURY\\r\\n    ===================================================== */\\r\\n\\r\\n    function withdraw()\\r\\n        external\\r\\n        onlyOwner\\r\\n        nonReentrant\\r\\n    {\\r\\n        uint256 balance =\\r\\n            address(this)\\r\\n                .balance;\\r\\n\\r\\n        require(\\r\\n            balance > 0,\\r\\n            \\\"Nothing to withdraw\\\"\\r\\n        );\\r\\n\\r\\n        (\\r\\n            bool success,\\r\\n        ) =\\r\\n            payable(owner())\\r\\n                .call{\\r\\n                    value: balance\\r\\n                }(\\\"\\\");\\r\\n\\r\\n        require(\\r\\n            success,\\r\\n            \\\"Withdraw failed\\\"\\r\\n        );\\r\\n    }\\r\\n\\r\\n\\r\\n    receive()\\r\\n        external\\r\\n        payable\\r\\n    {\\r\\n        revert(\\r\\n            \\\"Use buyGoldDust\\\"\\r\\n        );\\r\\n    }\\r\\n}\\r\\n\",\"keccak256\":\"0x36b8085f00a054f020db3a636a2dedc751c6cc7935bb0e6393c79bc1f90ef1fd\",\"license\":\"MIT\"}},\"version\":1}"