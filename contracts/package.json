{
  "name": "contracts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "deploy:orchard": "hardhat run scripts/deploySoapyMinerGame.js --network orchard",
    "deploy:cyprus1": "hardhat run scripts/deploySoapyMinerGame.js --network cyprus1",
    "verify:orchard": "hardhat run scripts/verifySoapyMinerGame.js --network orchard",
    "verify:cyprus1": "hardhat run scripts/verifySoapyMinerGame.js --network cyprus1",
    "console:orchard": "hardhat console --network orchard",
    "console:cyprus1": "hardhat console --network cyprus1",
    "indexer": "node scripts/indexers/runIndexers.js",
    "indexer:game": "node scripts/indexers/gameIndexer.js",
    "indexer:market": "node scripts/indexers/marketplaceIndexer.js",
    "indexer:reward": "node scripts/indexers/rewardMineIndexer.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "quais": "^1.0.0-alpha.55"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@quai/hardhat-deploy-metadata": "^1.0.8",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "ethers": "^6.17.0",
    "hardhat": "2.19.5",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2"
  }
